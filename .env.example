# MNEMOS environment — every knob, Docker-ready
# (docker run -e MNEMOS_BACKEND=disk -e OPENAI_API_KEY=... -v mnemos-data:/data ...).
# Binary `nmose` auto-loads .env, deploy/.env, local/.env if present (no need to export).
#
# ── Storage (embedded by default; no server needed) ──
# Backend: disk (default) | memory | object | http
#   disk   — embedded engine on local disk (MNEMOS_DATA_ROOT)
#   memory — embedded in-process memory (tests, ephemeral)
#   object — S3-compatible store (needs MNEMOS_OBJECT_BUCKET)
#   http   — Helix server at HELIX_URL (explicit server mode, no fallback)
MNEMOS_BACKEND=disk

# Local data root for the disk backend. In Docker, mount a volume here,
# e.g. -v mnemos-data:/data/helix with MNEMOS_DATA_ROOT=/data/helix.
MNEMOS_DATA_ROOT=./data/helix
MNEMOS_DATABASE=mnemos

# Object-storage backend (S3/MinIO). Empty bucket = not configured,
# falls back to disk, then memory.
MNEMOS_OBJECT_BUCKET=
MNEMOS_OBJECT_REGION=us-east-1
# MNEMOS_OBJECT_ENDPOINT=http://minio:9000
# MNEMOS_OBJECT_ALLOW_HTTP=true

# NOTE: HELIX_URL is used ONLY when MNEMOS_BACKEND=http. With the default
# embedded disk backend it is ignored entirely — no server to point at.
HELIX_URL=http://localhost:6969

# Fallback chain (automatic):
#   disk requested + empty MNEMOS_DATA_ROOT -> memory
#   object requested + empty MNEMOS_OBJECT_BUCKET -> disk -> memory
#
# ── Chat LLM (called at ingestion + mitosis naming + contradiction check) ──
# Provider: openai (default) | xai | anthropic | ollama
# xAI Grok is OpenAI-compatible at https://api.x.ai/v1 — use LLM_PROVIDER=xai with OPENAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any OpenAI-compatible base URL (Groq, Together, Ollama, xAI, DeepSeek...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: XAI_API_KEY=... (if set, overrides OPENAI_API_KEY when LLM_PROVIDER=xai)
LLM_MODEL=gpt-4o-mini
# Only used when LLM_PROVIDER=anthropic and set (else OPENAI_API_KEY).
# ANTHROPIC_API_KEY=

# Transport retries for chat completions (network errors, 408/429/5xx only;
# never on 400/401/403/404). Backoff 100ms doubling, capped at 2s.
MNEMOS_LLM_MAX_RETRIES=3

# ── Embeddings (called on every ingest + recall; dim must match the store) ──
# Provider: openai (default, 1536-dim) | local (fastembed, 384-dim).
# WARNING: do not mix providers against one store — dimensions differ.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Separate base URL for embeddings (e.g. local Docker `http://localhost:8699/v1`).
# Falls back to OPENAI_BASE_URL when unset — set this for your local OpenAI-compatible embedding server.
# EMBEDDING_BASE_URL=http://localhost:8699/v1
# Vector dimension for `engram setup` (must match stored vectors exactly).
# Defaults: 384 for EMBEDDING_PROVIDER=local, 1536 otherwise. Explicit value always wins.
# EMBEDDING_DIM=384

# ── Recall mode ──
# Spreading-activation wave (always on): seed CRR → spread across
# Reinforces/TemporalSequence/Contradicts via LEARNED edge weights → merge.
# This is what makes rewarded weights visibly shape ranking.
# Set MNEMOS_RECALL_WAVE=0 to revert to single-pass CRR (faster, no wave).
# MNEMOS_RECALL_WAVE=0

# ── MCP ──
# STDIO (default, no endpoints): the MCP client (Claude Desktop, opencode)
# spawns `mnemos mcp-server` / `mnemos mcp-tools` as a subprocess.
# No ports, no URLs, no auth env vars.
#
# HTTP (`mnemos mcp-http`): serves all three MCP surfaces on one port —
#   :PORT/mcp      protocol tools (recall, store, contradiction_check, consolidate)
#   :PORT/mcp/tools CLI tools (mnemos_ingest, mnemos_recall, ...) + help tool
#   :PORT/mcp/cli  single-tool CLI (mnemos_cli) with two-layer help
#     (call {"command":"help"} for the list, {"command":"help","args":["<cmd>"]}
#     for per-command usage; same commands exist as `mnemos <cmd>` on the shell)
MNEMOS_MCP_HOST=127.0.0.1
MNEMOS_MCP_PORT=4545
# Optional bearer token for HTTP MCP (all /mcp/* routes).
# If set, clients must send `Authorization: Bearer <token>` (e.g. in MCP client config).
# Leave empty for open access (local/single-user). Docker: -e MNEMOS_MCP_TOKEN=...
# MNEMOS_MCP_TOKEN=

# ── Telemetry (what failed and why, per crate::op) ──
# In-memory ring (1024 events) is always kept and also appended to
# ./data/helix/mnemos-telemetry.jsonl by default (live via GET :4545/telemetry).
# Set MNEMOS_TELEMETRY=0 to disable, or MNEMOS_TELEMETRY_FILE= to override path.
MNEMOS_TELEMETRY=1
# MNEMOS_TELEMETRY_FILE=./data/helix/mnemos-telemetry.jsonl

# ── Learning — persisted weights ──
# Learned EdgeWeights survive restarts via atomic file (write tmp → rename on every reward).
MNEMOS_WEIGHTS_FILE=./data/helix/mnemos-weights.json
